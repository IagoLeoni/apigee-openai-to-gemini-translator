# Copie para config.env e ajuste com os dados do seu ambiente.
export PROJECT_ID="seu-projeto-gcp"
export APIGEE_ORG="$PROJECT_ID"
export APIGEE_ENV="eval"
export APIGEE_HOST="seu-host.apigee.io"

# Vertex AI
export VERTEX_PROJECT="$PROJECT_ID"
export VERTEX_LOCATION="global"              # "global" ou "us-central1"
export VERTEX_HOST="aiplatform.googleapis.com"

# Service account para chamar o Vertex
export PROXY_SA="apigee-ai-gateway@${PROJECT_ID}.iam.gserviceaccount.com"

export PROXY_NAME="llm-gateway-v1"
export PRODUCT_NAME="llm-gateway-standard"
export DEVELOPER_EMAIL="developer@exemplo.com"
export APP_NAME="agente-piloto"
