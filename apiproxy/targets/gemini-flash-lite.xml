<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="gemini-flash-lite">
  <Description>Vertex AI Model Garden - gemini-3.1-flash-lite (modelo economico)</Description>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-SetVertexTarget</Name>
      </Step>
    </Request>
    <Response>
      <Step>
        <Name>JS-VertexErrorToOpenAI</Name>
        <Condition>response.status.code != 200</Condition>
      </Step>
    </Response>
  </PreFlow>
  <HTTPTargetConnection>
    <Authentication>
      <GoogleAccessToken>
        <Scopes>
          <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
        </Scopes>
      </GoogleAccessToken>
    </Authentication>
    <URL>https://us-central1-aiplatform.googleapis.com</URL>
    <Properties>
      <Property name="success.codes">1xx,2xx,3xx,4xx,5xx</Property>
      <Property name="target.copy.pathsuffix">false</Property>
      <Property name="io.timeout.millis">60000</Property>
      <Property name="connect.timeout.millis">10000</Property>
      <Property name="supports.post.without.content.length">true</Property>
    </Properties>
  </HTTPTargetConnection>
</TargetEndpoint>
